# Copy to .env and fill in. Real environment variables override this file. Never commit .env.

# ── Databricks auth (pick ONE, standard Databricks unified auth) ──
# a) a profile from ~/.databrickscfg (created by `databricks auth login --host <url> --profile <name>`)
DATABRICKS_CONFIG_PROFILE=
# b) or host + personal access token
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=

# ── Optional ──
# SQL warehouse to use (setup.py auto-detects one if empty)
DATABRICKS_WAREHOUSE_ID=
# Catalog/schema for the POC tables (catalog must exist and be writable)
POC_CATALOG=workspace
POC_SCHEMA=poc_dashboard
# Domains allowed to embed the dashboards (added to the workspace list, never replacing it)
POC_EMBED_DOMAINS=localhost,127.0.0.1

# ── Option 2 service principal: filled in automatically by setup.py ──
DATABRICKS_SP_CLIENT_ID=
DATABRICKS_SP_CLIENT_SECRET=
