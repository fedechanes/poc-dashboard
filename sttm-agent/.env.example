# Copy to sttm-agent/.env and fill in. Real environment variables override this file. Never commit .env.

# Databricks auth: standard unified auth, e.g. a profile from ~/.databrickscfg
DATABRICKS_CONFIG_PROFILE=
# or host + token
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=

# Optional. SQL warehouse (auto-detected: first warehouse in the workspace)
DATABRICKS_WAREHOUSE_ID=
# Catalog for all schemas (must exist and be writable)
STTM_CATALOG=workspace
# Schemas become <prefix>_landing, _bronze, _silver, _gold, _meta
STTM_PREFIX=sttm
STTM_PIPELINE_NAME=sttm-medallion
# Chat endpoint that drafts and checks definitions; 'none' = rule-based fallback without an LLM
STTM_LLM_ENDPOINT=databricks-qwen3-next-80b-a3b-instruct
