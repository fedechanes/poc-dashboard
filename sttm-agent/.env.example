# Copy to sttm-agent/.env and fill in. Real environment variables override this file. Never commit .env.

# Databricks auth: standard unified auth, e.g. a profile from ~/.databrickscfg
DATABRICKS_CONFIG_PROFILE=
# or host + token
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=

# Optional. SQL warehouse (auto-detected: first warehouse in the workspace)
DATABRICKS_WAREHOUSE_ID=
# Catalog for all schemas (must exist and be writable)
STTM_CATALOG=workspace
# Schemas become <prefix>_landing, _bronze, _silver, _gold, _meta
STTM_PREFIX=sttm
STTM_PIPELINE_NAME=sttm-medallion
# Chat endpoint that drafts and checks definitions and decides the personal data level of bronze column names the
# rules can't decide (metadata only, never values); 'none' = rule-based fallback without an LLM
STTM_LLM_ENDPOINT=databricks-qwen3-next-80b-a3b-instruct
# Name of the viewer Databricks App (run.py app-deploy)
STTM_APP_NAME=sttm-viewer
# Group whose members may approve definitions and run the agent from the app (empty = anyone with app access)
STTM_STEWARDS_GROUP=sttm-stewards
# Person every owner team in glossary.toml maps to when it is first added to <prefix>_meta.owners
# (empty = the user running the agent or app-deploy). Split teams later by editing the owners table.
STTM_DEFAULT_OWNER=
# Days the change data feed of sttm, glossary, sensitivity_overrides, issues and issue_status stays readable for the
# viewer's History
# (sets delta.deletedFileRetentionDuration on those tables; the log is kept for at least 30 days)
STTM_HISTORY_RETENTION_DAYS=30
# Days of history in the viewer's "Download for audit" workbook
STTM_AUDIT_HISTORY_DAYS=30
# Name of the demo AI/BI dashboard over gold that `run.py demo-dashboard` creates (a downstream consumer to show)
STTM_DEMO_DASHBOARD_NAME=STTM demo - Sales
